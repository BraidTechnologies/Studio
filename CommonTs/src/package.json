{
    "name": "commonts",
    "version": "0.1.0",
    "description": "Common Types and Interfaces",
    "main": "./dist/src/index.ts",
    "types": "./dist/src/index.d.ts",
    "files": [
        "dist/",
        "src/",
        "package.json",
        "README.md"
    ],
    "scripts": {
        "build": "tsc",
        "watch": "tsc -b -w",
        "clean": "rimraf dist",
        "make_api_def_json": "npx typeconv -f ts -t jsc src/*.Types.ts",
        "make_api_def_yaml": "npx typeconv -f ts -t oapi src/*.Types.ts",
        "test": "mocha --debug-brk --exit --require ts-node/register test/*.test.ts",
        "test-mini": "mocha --debug-brk --exit --require ts-node/register test/*summar*.test.ts"
    },
    "devDependencies": {
        "@fluidframework/azure-client": "^2.13.0",
        "@fluidframework/routerlicious-driver": "^2.13.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.10.7",
        "@types/pako": "^2.0.3",
        "expect": "^29.7.0",
        "mocha": "^11.0.1",
        "rimraf": "^6.0.1",
        "rimraff": "^0.0.1-security",
        "ts-node": "^10.9.2",
        "tslib": "^2.8.1",
        "typeconv": "^2.3.1",
        "typescript": "^5.7.3",
        "webpack-cli": "^6.0.1"
    },
    "dependencies": {
        "axios": "^1.7.9",
        "axios-retry": "^4.5.0",
        "fluid-framework": "^2.13.0",
        "gpt4-tokenizer": "^1.3.0",
        "groq-sdk": "^0.12.0",
        "pako": "^2.1.0",
        "promptmanager": "file:../PromptManager/ts-client/promptmanager-1.0.0.tgz",
        "webpack": "^5.98.0"
    }
}
