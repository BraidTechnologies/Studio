{
  "name": "promptmanager",
  "version": "1.0.0",
  "description": "Managing System Wide Prompts and Evals ",
  "main": "dist/node/bundle.js",
  "browser": "dist/browser/bundle.js",
  "types": "dist/bundle.d.ts",
  "directories": {
    "test": "test"
  },
  "author": "",
  "license": "ISC",
  "scripts": {
    "start": "ts-node entry.ts",
    "build:bundle": "esbuild ./entry.ts --bundle --platform=node --outfile=dist/bundle.js",
    "build": "tsc && npm run copy-prompts && npm run copy-interfaces && npm run build:bundle",
    "copy-prompts": "copyfiles -u 2 \"../prompts/**/*\" \"dist/prompts\"",
    "copy-interfaces": "copyfiles -u 2 \"../interfaces/**/*\" \"dist/interfaces\"",
    "make_prompt_ids": "ts-node src/helpers/MakePromptIds.ts",
    "watch": "tsc -b -w",
    "clean": "rimraf dist",
    "test": "mocha src/test/**/*.test.ts"
  },
  "devDependencies": {
    "@fluidframework/azure-client": "^2.13.0",
    "@fluidframework/routerlicious-driver": "^2.13.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.8",
    "@types/pako": "^2.0.3",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.24.2",
    "expect": "^29.7.0",
    "mocha": "^11.0.1",
    "rimraf": "^6.0.1",
    "rimraff": "^0.0.1-security",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typeconv": "^2.3.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "axios-retry": "^4.5.0",
    "commonts": "file:../../CommonTs",
    "fluid-framework": "^2.13.0",
    "gpt4-tokenizer": "^1.3.0",
    "groq-sdk": "^0.12.0",
    "pako": "^2.1.0"
  }
}
