{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es6",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "declaration": true, 
    "declarationMap": true, 
    "composite": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],  
    "moduleResolution": "node",
  },
  "references": [],
  "include": [
    "**/*.ts",
    "**/*.json",
    "src/**/*.ts",
    "cache/**/*.ts"
  ]
}