{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es6",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    "rootDir": ".",
    "sourceMap": false,
    "strict": true,
    "noImplicitAny": true,
    "declaration": true, 
    "declarationMap": true, 
    "composite": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "references": [],
  "include": [
    "**/*.ts",
    "**/*.json",
    "ts-client/**/*.ts"]
}